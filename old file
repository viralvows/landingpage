  <script>
    // ── Nav scroll effect ───────────────────────────────────────────────────
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
      navbar.classList.toggle('scrolled', window.scrollY > 60);
    });

    // ── Reveal on scroll ───────────────────────────────────────────────────
    const revealEls = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.12 });
    revealEls.forEach(el => observer.observe(el));

    // ── Smooth stat counter animation ──────────────────────────────────────
    function animateCount(el, target, suffix, duration) {
      const start = performance.now();
      const isDecimal = target % 1 !== 0;
      const step = (now) => {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const ease = 1 - Math.pow(1 - progress, 3);
        const current = isDecimal
          ? (target * ease).toFixed(1)
          : Math.floor(target * ease);
        el.textContent = current.toLocaleString() + suffix;
        if (progress < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }

    // Hero stat counters
    const heroStatNums = document.querySelectorAll('.hero-stat-num');
    const heroData = [
      { val: 10,  suffix: 'M+' },
      { val: 5,   suffix: 'M+' },
      { val: 10,  suffix: 'K+' },
      { val: 4,   suffix: ' Mo.' },
    ];
    const heroObserver = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          heroStatNums.forEach((el, i) => {
            animateCount(el, heroData[i].val, heroData[i].suffix, 1800);
          });
          heroObserver.disconnect();
        }
      });
    }, { threshold: 0.5 });
    if (heroStatNums[0]) heroObserver.observe(heroStatNums[0].closest('.hero-stats'));
  </script>
