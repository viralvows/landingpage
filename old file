<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Viral Vows Co. — Wedding & Event Content Creation</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    /* ── Reset & Base ─────────────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --white:   #FFFFFF;
      --pearl:   #f5efe8;   /* lightest cream   — primary bg          */
      --linen:   #efe6dc;   /* soft linen       — alternate sections  */
      --sand:    #d8c7b7;   /* warm sand        — borders, mid tones  */
      --taupe:   #a39286;   /* rose taupe       — labels, secondary   */
      --cacao:   #7a6156;   /* warm cocoa       — accent only         */
      --leather: #311c14;   /* deep espresso    — primary dark        */
      --serif:   'Cormorant Garamond', Georgia, serif;
      --sans:    'Montserrat', sans-serif;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--pearl);
      color: var(--leather);
      font-family: var(--sans);
      font-weight: 300;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Nav ──────────────────────────────────────────────────────────────── */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 24px 60px;
      background: transparent;
      transition: background 0.4s ease, padding 0.4s ease;
    }
    nav.scrolled {
      background: rgba(245,239,232,0.96);
      backdrop-filter: blur(12px);
      padding: 16px 60px;
      border-bottom: 1px solid var(--sand);
    }
    .nav-logo {
      font-family: var(--serif);
      font-size: 22px;
      font-weight: 500;
      letter-spacing: 3px;
      color: var(--white);
      text-decoration: none;
      transition: color 0.4s;
    }
    nav.scrolled .nav-logo { color: var(--leather); }

    .nav-links { display: flex; gap: 36px; list-style: none; }
    .nav-links a {
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: rgba(255,255,255,0.85);
      text-decoration: none;
      transition: color 0.3s;
    }
    .nav-links a:hover { color: var(--white); }
    nav.scrolled .nav-links a { color: var(--taupe); }
    nav.scrolled .nav-links a:hover { color: var(--cacao); }

    /* ── Hero ─────────────────────────────────────────────────────────────── */
    #hero {
      position: relative;
      height: 100vh;
      min-height: 700px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      background: var(--leather);
      overflow: hidden;
    }

    /* Texture overlay */
    #hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 80% 60% at 50% 40%, rgba(122,97,86,0.6) 0%, transparent 70%),
        linear-gradient(180deg, rgba(49,28,20,0.3) 0%, rgba(49,28,20,0.7) 100%);
      z-index: 1;
    }

    /* Animated grain texture */
    #hero::after {
      content: '';
      position: absolute;
      inset: -50%;
      width: 200%; height: 200%;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      opacity: 0.35;
      z-index: 0;
    }

    /* Large decorative background text */
    .hero-bg-text {
      position: absolute;
      font-family: var(--serif);
      font-size: clamp(120px, 20vw, 260px);
      font-weight: 300;
      letter-spacing: -4px;
      color: rgba(163,146,134,0.07);
      line-height: 1;
      user-select: none;
      z-index: 1;
      white-space: nowrap;
    }

    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 880px;
      padding: 0 40px;
    }

    .hero-eyebrow {
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 5px;
      text-transform: uppercase;
      color: var(--taupe);
      margin-bottom: 24px;
    }

    .hero-title {
      font-family: var(--serif);
      font-size: clamp(56px, 9vw, 108px);
      font-weight: 300;
      line-height: 0.95;
      color: var(--white);
      letter-spacing: -1px;
      margin-bottom: 10px;
    }
    .hero-title em {
      font-style: italic;
      font-weight: 300;
      color: var(--taupe);
    }

    .hero-subtitle {
      font-family: var(--serif);
      font-size: clamp(18px, 2.5vw, 26px);
      font-weight: 300;
      font-style: italic;
      color: rgba(245,239,232,0.65);
      margin: 28px 0 48px;
      letter-spacing: 0.5px;
    }

    .hero-cta-group { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

    .btn-primary {
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      text-decoration: none;
      padding: 18px 44px;
      background: var(--leather);
      color: var(--white);
      border: none;
      cursor: pointer;
      transition: background 0.3s ease, transform 0.2s ease;
      display: inline-block;
    }
    .btn-primary:hover { background: var(--cacao); transform: translateY(-2px); }

    .btn-ghost {
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 3px;
      text-transform: uppercase;
      text-decoration: none;
      padding: 17px 44px;
      background: transparent;
      color: var(--white);
      border: 1px solid rgba(255,255,255,0.35);
      cursor: pointer;
      transition: border-color 0.3s, color 0.3s, transform 0.2s;
      display: inline-block;
    }
    .btn-ghost:hover {
      border-color: var(--taupe);
      color: var(--taupe);
      transform: translateY(-2px);
    }

    /* Hero stat ticker */
    .hero-stats {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      z-index: 3;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border-top: 1px solid rgba(163,146,134,0.25);
    }
    .hero-stat {
      padding: 28px 20px;
      text-align: center;
      border-right: 1px solid rgba(163,146,134,0.2);
      background: rgba(49,28,20,0.6);
      backdrop-filter: blur(8px);
    }
    .hero-stat:last-child { border-right: none; }
    .hero-stat-num {
      font-family: var(--serif);
      font-size: 34px;
      font-weight: 400;
      color: var(--white);
      line-height: 1;
    }
    .hero-stat-label {
      font-family: var(--sans);
      font-size: 9px;
      font-weight: 500;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: var(--taupe);
      margin-top: 6px;
    }

    /* ── Section Shared ───────────────────────────────────────────────────── */
    section { padding: 110px 60px; }

    .section-eyebrow {
      font-family: var(--sans);
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: var(--taupe);
      margin-bottom: 16px;
      display: block;
    }
    .section-title {
      font-family: var(--serif);
      font-size: clamp(38px, 5vw, 64px);
      font-weight: 300;
      line-height: 1.05;
      color: var(--leather);
      letter-spacing: -0.5px;
    }
    .section-title em {
      font-style: italic;
      color: var(--taupe);
    }
    .section-divider {
      width: 60px;
      height: 1px;
      background: var(--cacao);   /* accent — used sparingly */
      margin: 28px 0;
    }
    .section-body {
      font-family: var(--sans);
      font-size: 14px;
      font-weight: 300;
      line-height: 1.9;
      color: var(--leather);
      max-width: 560px;
      opacity: 0.85;
    }

    /* ── Stats Section ────────────────────────────────────────────────────── */
    #stats {
      background: var(--leather);
      padding: 100px 60px;
    }

    .stats-header {
      text-align: center;
      margin-bottom: 72px;
    }
    .stats-header .section-eyebrow { color: var(--taupe); }
    .stats-header .section-title { color: var(--white); }
    .stats-header .section-divider { margin: 28px auto; background: var(--taupe); }

    .platform-block { margin-bottom: 64px; }
    .platform-label {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 28px;
    }
    .platform-name {
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--taupe);
    }
    .platform-followers {
      font-family: var(--serif);
      font-size: 14px;
      font-style: italic;
      color: rgba(163,146,134,0.6);
    }
    .platform-line {
      flex: 1;
      height: 1px;
      background: rgba(163,146,134,0.2);
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 2px;
    }
    .stat-card {
      background: rgba(255,255,255,0.03);
      padding: 36px 24px;
      border: 1px solid rgba(163,146,134,0.12);
      transition: background 0.3s, border-color 0.3s, transform 0.3s;
      cursor: default;
    }
    .stat-card:hover {
      background: rgba(163,146,134,0.08);
      border-color: rgba(163,146,134,0.3);
      transform: translateY(-4px);
    }
    .stat-number {
      font-family: var(--serif);
      font-size: clamp(28px, 3.5vw, 42px);
      font-weight: 400;
      color: var(--white);
      line-height: 1;
      margin-bottom: 8px;
    }
    .stat-name {
      font-family: var(--sans);
      font-size: 9px;
      font-weight: 500;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--taupe);
      margin-bottom: 8px;
    }
    .stat-growth {
      font-family: var(--serif);
      font-size: 13px;
      font-style: italic;
      color: rgba(163,146,134,0.55);
    }

    .viral-callout {
      margin-top: 60px;
      padding: 48px 60px;
      background: rgba(163,146,134,0.08);
      border: 1px solid rgba(163,146,134,0.2);
      border-left: 3px solid var(--taupe);
      display: flex;
      align-items: center;
      gap: 48px;
    }
    .viral-callout-label {
      font-family: var(--sans);
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--taupe);
      white-space: nowrap;
    }
    .viral-callout-num {
      font-family: var(--serif);
      font-size: 52px;
      font-weight: 300;
      color: var(--white);
      white-space: nowrap;
    }
    .viral-callout-desc {
      font-family: var(--sans);
      font-size: 13px;
      font-weight: 300;
      color: rgba(245,239,232,0.6);
      line-height: 1.8;
    }

    /* ── About Section ────────────────────────────────────────────────────── */
    #about {
      background: var(--pearl);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 100px;
      align-items: center;
    }
    .about-quote {
      font-family: var(--serif);
      font-size: clamp(32px, 4vw, 52px);
      font-weight: 300;
      font-style: italic;
      line-height: 1.2;
      color: var(--leather);
      position: relative;
      padding-left: 32px;
    }
    .about-quote::before {
      content: '"';
      position: absolute;
      left: 0;
      top: -10px;
      font-family: var(--serif);
      font-size: 80px;
      color: var(--sand);
      line-height: 1;
    }

    /* ── Services Section ─────────────────────────────────────────────────── */
    #services { background: var(--linen); }

    .services-header {
      max-width: 540px;
      margin-bottom: 72px;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2px;
    }
    .service-card {
      background: var(--white);
      padding: 48px 40px;
      position: relative;
      overflow: hidden;
      transition: background 0.4s ease, transform 0.3s ease;
      cursor: default;
    }
    .service-card::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0;
      width: 100%; height: 3px;
      background: var(--cacao);   /* accent thread */
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s ease;
    }
    .service-card:hover { background: var(--pearl); transform: translateY(-6px); }
    .service-card:hover::after { transform: scaleX(1); }

    .service-num {
      font-family: var(--serif);
      font-size: 52px;
      font-weight: 300;
      color: var(--sand);
      line-height: 1;
      margin-bottom: 24px;
    }
    .service-title {
      font-family: var(--serif);
      font-size: 22px;
      font-weight: 500;
      color: var(--leather);
      margin-bottom: 16px;
      line-height: 1.2;
    }
    .service-desc {
      font-family: var(--sans);
      font-size: 12.5px;
      font-weight: 300;
      line-height: 1.85;
      color: var(--taupe);
    }

    /* ── Clients Section ──────────────────────────────────────────────────── */
    #clients { background: var(--pearl); }

    .clients-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 72px;
    }

    .clients-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2px;
      margin-bottom: 72px;
    }
    .client-card {
      background: var(--white);
      padding: 52px 48px;
      border: 1px solid transparent;
      transition: border-color 0.3s, transform 0.3s;
    }
    .client-card:hover {
      border-color: var(--sand);
      transform: translateY(-4px);
    }
    .client-type {
      font-family: var(--sans);
      font-size: 9px;
      font-weight: 500;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--taupe);
      margin-bottom: 14px;
    }
    .client-name {
      font-family: var(--serif);
      font-size: 28px;
      font-weight: 400;
      color: var(--leather);
      margin-bottom: 20px;
    }
    .client-desc {
      font-family: var(--sans);
      font-size: 13px;
      font-weight: 300;
      line-height: 1.85;
      color: var(--taupe);
    }
    .client-divider {
      width: 32px;
      height: 1px;
      background: var(--sand);
      margin: 24px 0;
    }

    /* Process strip */
    .process-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      background: var(--leather);
    }
    .process-step {
      padding: 52px 48px;
      border-right: 1px solid rgba(245,239,232,0.1);
    }
    .process-step:last-child { border-right: none; }
    .process-step-num {
      font-family: var(--serif);
      font-size: 48px;
      font-weight: 300;
      color: rgba(163,146,134,0.3);
      line-height: 1;
      margin-bottom: 16px;
    }
    .process-step-title {
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--taupe);
      margin-bottom: 14px;
    }
    .process-step-desc {
      font-family: var(--sans);
      font-size: 12.5px;
      font-weight: 300;
      line-height: 1.85;
      color: rgba(245,239,232,0.55);
    }

    /* ── Why Viral Vows ───────────────────────────────────────────────────── */
    #why {
      background: var(--leather);
      text-align: center;
    }
    #why .section-title { color: var(--white); }
    #why .section-eyebrow { color: var(--taupe); }
    #why .section-divider { margin: 28px auto; background: var(--taupe); }

    .why-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
      margin-top: 72px;
    }
    .why-item {
      padding: 0 16px;
    }
    .why-icon {
      font-family: var(--serif);
      font-size: 40px;
      color: var(--taupe);
      margin-bottom: 20px;
      line-height: 1;
    }
    .why-title {
      font-family: var(--serif);
      font-size: 20px;
      font-weight: 400;
      color: var(--white);
      margin-bottom: 12px;
    }
    .why-desc {
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 300;
      line-height: 1.85;
      color: rgba(163,146,134,0.7);
    }

    /* ── CTA Section ──────────────────────────────────────────────────────── */
    #contact {
      background: var(--pearl);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      padding: 0;
    }
    .contact-left {
      background: var(--leather);
      padding: 110px 72px;
    }
    .contact-left .section-title { color: var(--white); font-size: clamp(36px, 4.5vw, 60px); }
    .contact-left .section-eyebrow { color: var(--taupe); }
    .contact-left .section-divider { background: rgba(163,146,134,0.4); }
    .contact-left .section-body { color: rgba(245,239,232,0.65); max-width: 420px; }

    .contact-right {
      background: var(--white);
      padding: 110px 72px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .contact-item {
      padding: 28px 0;
      border-bottom: 1px solid var(--sand);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .contact-item:first-child { border-top: 1px solid var(--sand); }
    .contact-item-label {
      font-family: var(--sans);
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--taupe);
    }
    .contact-item-value {
      font-family: var(--serif);
      font-size: 18px;
      font-weight: 400;
      color: var(--leather);
    }

    .contact-cta-wrap { margin-top: 48px; }
    .contact-cta-wrap .btn-primary { width: 100%; text-align: center; padding: 22px; }

    /* ── Footer ───────────────────────────────────────────────────────────── */
    footer {
      background: var(--leather);
      padding: 40px 60px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid rgba(163,146,134,0.15);
    }
    .footer-logo {
      font-family: var(--serif);
      font-size: 18px;
      font-weight: 400;
      letter-spacing: 3px;
      color: var(--taupe);
    }
    .footer-copy {
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 300;
      letter-spacing: 1.5px;
      color: rgba(163,146,134,0.4);
    }
    .footer-socials {
      display: flex;
      gap: 24px;
    }
    .footer-socials span {
      font-family: var(--sans);
      font-size: 9px;
      font-weight: 500;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: rgba(163,146,134,0.5);
    }

    /* ── Reveal Animation ─────────────────────────────────────────────────── */
    .reveal {
      opacity: 0;
      transform: translateY(32px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .reveal-delay-1 { transition-delay: 0.1s; }
    .reveal-delay-2 { transition-delay: 0.2s; }
    .reveal-delay-3 { transition-delay: 0.3s; }
    .reveal-delay-4 { transition-delay: 0.4s; }
    .reveal-delay-5 { transition-delay: 0.5s; }

    /* ── Counter animation ────────────────────────────────────────────────── */
    .count-up { display: inline-block; }

    /* ── Social Shift Section ─────────────────────────────────────────────── */
    #shift { background: var(--pearl); padding: 110px 60px; }
    .shift-header { max-width: 700px; margin: 0 auto 80px; text-align: center; }
    .shift-manifesto {
      background: var(--leather);
      padding: 72px 80px;
      margin-bottom: 72px;
      position: relative;
      overflow: hidden;
    }
    .shift-manifesto::before {
      content: '"';
      position: absolute;
      top: -20px; left: 48px;
      font-family: var(--serif);
      font-size: 240px;
      color: rgba(163,146,134,0.07);
      line-height: 1;
      pointer-events: none;
    }
    .shift-manifesto-text {
      font-family: var(--serif);
      font-size: clamp(20px, 2.8vw, 34px);
      font-weight: 300;
      font-style: italic;
      color: var(--white);
      line-height: 1.6;
      max-width: 780px;
      margin: 0 auto;
      text-align: center;
      position: relative;
      z-index: 1;
    }
    .shift-manifesto-text em { color: var(--taupe); font-style: normal; }
    .shift-data-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2px;
      margin-bottom: 72px;
    }
    .shift-data-card {
      background: var(--white);
      padding: 48px 32px;
      border-bottom: 3px solid transparent;
      transition: border-color 0.3s, transform 0.3s;
    }
    .shift-data-card:hover { border-color: var(--cacao); transform: translateY(-4px); }
    .shift-data-num {
      font-family: var(--serif);
      font-size: clamp(28px, 3.5vw, 44px);
      font-weight: 400;
      color: var(--leather);
      line-height: 1;
      margin-bottom: 10px;
    }
    .shift-data-label {
      font-family: var(--sans);
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 2px;
